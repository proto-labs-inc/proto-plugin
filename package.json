{
  "name": "proto-prototypes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -p 1985",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "link-source": "pnpm --dir node_modules/proto-plugin link-source",
    "setup-host": "pnpm --dir node_modules/proto-plugin setup-host",
    "sync-from-source": "pnpm --dir node_modules/proto-plugin sync-from-source",
    "link-source-db": "pnpm --dir node_modules/proto-plugin link-source-db",
    "verify:prototype-ids": "pnpm --dir node_modules/proto-plugin verify:prototype-ids",
    "verify:prototype-preview-states": "pnpm --dir node_modules/proto-plugin verify:prototype-preview-states",
    "share-prototype": "pnpm --dir node_modules/proto-plugin share-prototype",
    "verify:source-linked": "test -L source && node node_modules/proto-plugin/scripts/verify-host-env.mjs SOURCE_PATH",
    "verify:workspace-profile": "node node_modules/proto-plugin/scripts/verify-host-env.mjs PROTOTYPE_USER_NAME",
    "verify:onboarded": "node node_modules/proto-plugin/scripts/verify-bootstrap-flag.mjs onboarded",
    "verify:bootstrap-status": "node node_modules/proto-plugin/scripts/verify-bootstrap-status.mjs",
    "verify:design-system-static": "node node_modules/proto-plugin/scripts/verify-design-system-static.mjs",
    "verify:design-system-visual": "node node_modules/proto-plugin/scripts/verify-design-system-visual.mjs",
    "verify:tailwind-theme": "node node_modules/proto-plugin/scripts/verify-tailwind-theme-registration.mjs",
    "verify:component-library-loaded": "node node_modules/proto-plugin/scripts/verify-bootstrap-flag.mjs component-library-loaded",
    "verify:design-system-loaded": "node node_modules/proto-plugin/scripts/verify-bootstrap-flag.mjs design-system-loaded"
  },
  "dependencies": {
    "@calcom/lib": "workspace:*",
    "@calcom/ui": "workspace:*",
    "@coss/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "common": "workspace:*",
    "dialkit": "^1.3.0",
    "icons": "workspace:*",
    "lucide-react": "^0.436.0",
    "motion": "^12.42.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "proto-plugin": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.5.0",
    "ui": "workspace:*",
    "ui-patterns": "workspace:*"
  },
  "devDependencies": {
    "@radix-ui/react-tooltip": "1.0.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "sharp",
      "unrs-resolver"
    ]
  }
}
