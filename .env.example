# Host-only — keep in `.env.local`. Do not overwrite with `vercel env pull .env.local`.
SOURCE_PATH=/Users/maayanalbert/Documents/proto-site
PROTOTYPE_USER_NAME=
PROTOTYPE_COMPANY_NAME=

# --- Prototype comment + gallery persistence (required for Comments / gallery) ---
# Agent setup: copy the "Copy setup prompt" from the Comments sidebar, or follow `.env.example` flow.
# After Upstash Redis + Vercel Blob are on the Vercel project:
#   npx vercel env pull .env.development.local -y
# Next.js loads both `.env.local` and `.env.development.local` in development.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- Optional: PR split spec panel (Vercel preview URLs from GitHub) ---
# GITHUB_TOKEN=

